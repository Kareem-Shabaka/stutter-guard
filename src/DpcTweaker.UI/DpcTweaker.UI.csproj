<Project Sdk="Microsoft.NET.Sdk">

  <!-- View models: plain net10.0 (INotifyPropertyChanged + ICommand), so they build and test without WPF. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DpcTweaker.UI</RootNamespace>
    <AssemblyName>DpcTweaker.UI</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DpcTweaker.Core\DpcTweaker.Core.csproj" />
  </ItemGroup>

</Project>
