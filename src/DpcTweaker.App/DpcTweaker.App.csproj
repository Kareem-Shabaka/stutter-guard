<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StutterGuard</AssemblyName>
    <RootNamespace>DpcTweaker.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Measured, reversible DPC latency and stutter tuning for Windows.</Description>
    <Authors>Kareem Shabaka</Authors>
    <!-- Fluent theme (ThemeMode) is marked experimental in some .NET versions. -->
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
    <!-- One self-contained .exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No debug info in Release. Measured on 2026-11-15: with DebugType=embedded the same commit
         built in two directories produced two different binaries (65,460,090 / 65,460,096 / 65,460,939
         bytes), and with DebugType=none the same three builds produced one binary, byte for byte.
         The whole difference was the debug block - the PE TimeDateStamp at offset 0x88 plus the
         CodeView/PDB hashes. Keeping the PDB for Debug builds is what debugging needs; the release
         binary is smaller by about 22 KB without it. Prove it with:  build.cmd's verify-repro switch -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugType Condition="'$(Configuration)' != 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DpcTweaker.Core\DpcTweaker.Core.csproj" />
    <ProjectReference Include="..\DpcTweaker.UI\DpcTweaker.UI.csproj" />
  </ItemGroup>

</Project>
