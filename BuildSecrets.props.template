<Project>
  <!--
    LOCAL ONLY - this file is ignored by git and must never be committed, pasted into an issue, or
    screenshotted. It exists so a build can carry a working reporting address without that address ever
    entering the repository. Two previous webhook URLs were committed in Reports/TelemetryClient.cs, were
    found by a public-repository scanner on 2026-11-15, and were deleted by Discord permanently.

    Copy this file to BuildSecrets.props (same folder) and fill in the two values. `build.cmd` and
    `dotnet publish` pick it up automatically; with the file absent, nothing is baked in and the app asks
    for an address the first time someone uses it.

    Remember what is and is not protected: this keeps the address out of the REPOSITORY. It is still inside
    the binary anyone downloads, so treat it as semi-public and expect it to be abused eventually.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)BuildSecrets.props')">
    <StutterGuardReportWebhook></StutterGuardReportWebhook>
    <StutterGuardFeedbackWebhook></StutterGuardFeedbackWebhook>
  </PropertyGroup>
</Project>